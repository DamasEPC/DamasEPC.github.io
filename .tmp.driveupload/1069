<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Damas no EP</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sage: {
                            50: '#f4f7f4',
                            100: '#e3eae3',
                            200: '#c7d5c7',
                            300: '#a2b8a2',
                            600: '#557055',
                            700: '#435843',
                            800: '#354635',
                            900: '#2b392b',
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-sage-50 text-sage-900 min-h-screen flex flex-col justify-between">

    <header class="bg-sage-800 text-white shadow-md py-4 px-6">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
            <!-- Left Image -->
            <div class="flex items-center gap-3">
                <img src="Imagens para decorar/iniciojogo.jpg" 
                     onerror="this.src='https://placehold.co/100x70/354635/ffffff?text=Inicio';" 
                     alt="Início do Jogo" 
                     class="h-16 w-24 object-cover rounded shadow border border-sage-600">
                <span class="text-xs text-sage-200 hidden md:inline">Início</span>
            </div>

            <!-- Title -->
            <h1 class="text-3xl font-bold tracking-tight text-center text-sage-100">
                Damas no EP
            </h1>

            <!-- Right Image -->
            <div class="flex items-center gap-3">
                <span class="text-xs text-sage-200 hidden md:inline">Tab. Numerado</span>
                <img src="Imagens para decorar/tabnumerado.jpg" 
                     onerror="this.src='https://placehold.co/100x70/354635/ffffff?text=Tab.Num';" 
                     alt="Tabuleiro Numerado" 
                     class="h-16 w-24 object-cover rounded shadow border border-sage-600">
            </div>
        </div>
    </header>

    <section class="bg-sage-100 border-y border-sage-200 py-3 px-4">
        <div class="max-w-7xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="overflow-hidden rounded-lg shadow-sm bg-white border border-sage-200">
                <img src="Imagens para decorar/tabuleiros.gif" 
                     onerror="this.src='https://placehold.co/300x120/c7d5c7/354635?text=Tabuleiro+1';" 
                     alt="Tabuleiro 1" 
                     class="w-full h-24 object-cover hover:scale-105 transition-transform duration-300">
            </div>
            <div class="overflow-hidden rounded-lg shadow-sm bg-white border border-sage-200">
                <img src="Imagens para decorar/tabuleiros.gif" 
                     onerror="this.src='https://placehold.co/300x120/c7d5c7/354635?text=Tabuleiro+2';" 
                     alt="Tabuleiro 2" 
                     class="w-full h-24 object-cover hover:scale-105 transition-transform duration-300">
            </div>
            <div class="overflow-hidden rounded-lg shadow-sm bg-white border border-sage-200">
                <img src="Imagens para decorar/tabuleiros.gif" 
                     onerror="this.src='https://placehold.co/300x120/c7d5c7/354635?text=Tabuleiro+3';" 
                     alt="Tabuleiro 3" 
                     class="w-full h-24 object-cover hover:scale-105 transition-transform duration-300">
            </div>
            <div class="overflow-hidden rounded-lg shadow-sm bg-white border border-sage-200">
                <img src="Imagens para decorar/tabuleiros.gif" 
                     onerror="this.src='https://placehold.co/300x120/c7d5c7/354635?text=Tabuleiro+4';" 
                     alt="Tabuleiro 4" 
                     class="w-full h-24 object-cover hover:scale-105 transition-transform duration-300">
            </div>
        </div>
    </section>

    <main class="max-w-7xl mx-auto w-full p-4 sm:p-6 flex-grow grid grid-cols-1 md:grid-cols-4 gap-6">
        
        <!-- Left Column: Menu Buttons -->
        <div class="md:col-span-1 bg-white rounded-xl shadow-sm border border-sage-200 p-4">
            <h2 class="text-lg font-semibold text-sage-800 mb-4 border-b border-sage-100 pb-2">Menu Principal</h2>
            <nav id="menu-container" class="flex flex-col gap-2">
                <!-- Dynamically generated buttons via JS -->
            </nav>
        </div>

        <!-- Right Column: Dynamic Content & Items -->
        <div class="md:col-span-3 bg-white rounded-xl shadow-sm border border-sage-200 p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between border-b border-sage-100 pb-3 mb-4">
                    <h2 id="content-title" class="text-xl font-bold text-sage-800">Selecione uma opção no menu</h2>
                    <span id="category-badge" class="px-3 py-1 bg-sage-100 text-sage-700 text-xs font-medium rounded-full">Aguardando seleção</span>
                </div>
                
                <p id="content-description" class="text-sage-600 mb-6 text-sm sm:text-base">
                    Clique em um dos botões do menu à esquerda para visualizar os itens disponíveis correspondentes.
                </p>

                <!-- Dynamic Item Buttons Container -->
                <div id="items-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Dynamic buttons will appear here -->
                </div>
            </div>

            <div class="mt-8 pt-4 border-t border-sage-100 text-xs text-sage-500 text-center">
                Damas no EP &copy; 2026 - Todos os direitos reservados
            </div>
        </div>
    </main>

    <div id="media-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full overflow-hidden flex flex-col border border-sage-200 animate-in fade-in zoom-in duration-200">
            <!-- Modal Header -->
            <div class="bg-sage-800 text-white px-6 py-4 flex items-center justify-between">
                <h3 id="modal-title" class="font-semibold text-lg">Visualizador de Conteúdo</h3>
                <button onclick="closeModal()" class="text-sage-200 hover:text-white p-1 rounded-lg hover:bg-sage-700 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 flex flex-col items-center gap-4 bg-sage-50">
                <div id="modal-media-container" class="w-full flex justify-center bg-black/5 rounded-xl overflow-hidden max-h-[60vh] border border-sage-200 p-2">
                    <!-- Media loaded dynamically (img or video) -->
                </div>
                <div id="modal-text-box" class="w-full bg-white p-4 rounded-xl shadow-sm border border-sage-200 text-sage-700 text-sm">
                    <!-- Descriptive text box -->
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="bg-white px-6 py-4 border-t border-sage-200 flex justify-end gap-3">
                <button onclick="closeModal()" class="px-5 py-2.5 bg-sage-700 hover:bg-sage-800 text-white text-sm font-medium rounded-xl shadow-sm transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Voltar ao Damas no EP
                </button>
            </div>
        </div>
    </div>

    <script>
        // Menu categories data
        const menuItems = [
            { name: "Curtas", folder: "curta", ext: "jpg", type: "image" },
            { name: "Fichas", folder: "ficha", ext: "jpg", type: "image" },
            { name: "Filmes", folder: "filme", ext: "avi", type: "video" },
            { name: "Finais", folder: "final", ext: "jpg", type: "image" },
            { name: "Golpes", folder: "golpe", ext: "jpg", type: "image" },
            { name: "Jogos", folder: "jogo", ext: "jpg", type: "image" },
            { name: "Problemas", folder: "problema", ext: "jpg", type: "image" },
            { name: "Ficheiros", folder: "ficheiro", ext: "jpg", type: "image" }
        ];

        // Initialize menu buttons on load
        window.onload = function() {
            renderMenu();
            // Select the first menu item by default
            selectCategory(menuItems[0].name);
        };

        function renderMenu() {
            const menuContainer = document.getElementById('menu-container');
            menuContainer.innerHTML = '';

            menuItems.forEach(item => {
                const btn = document.createElement('button');
                btn.id = `menu-btn-${item.name}`;
                btn.className = "w-full text-left px-4 py-3 rounded-xl font-medium text-sm transition-all duration-200 flex items-center justify-between text-sage-700 hover:bg-sage-100 hover:text-sage-900 border border-transparent";
                btn.innerHTML = `
                    <span>${item.name}</span>
                    <svg class="w-4 h-4 text-sage-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                `;
                btn.onclick = () => selectCategory(item.name);
                menuContainer.appendChild(btn);
            });
        }

        function selectCategory(categoryName) {
            // Update active menu styling
            menuItems.forEach(item => {
                const b = document.getElementById(`menu-btn-${item.name}`);
                if (b) {
                    if (item.name === categoryName) {
                        b.className = "w-full text-left px-4 py-3 rounded-xl font-semibold text-sm transition-all duration-200 flex items-center justify-between bg-sage-700 text-white shadow-sm";
                    } else {
                        b.className = "w-full text-left px-4 py-3 rounded-xl font-medium text-sm transition-all duration-200 flex items-center justify-between text-sage-700 hover:bg-sage-100 hover:text-sage-900 border border-transparent";
                    }
                }
            });

            const category = menuItems.find(i => i.name === categoryName);
            if (!category) return;

            // Update header info
            document.getElementById('content-title').innerText = `Categoria: ${category.name}`;
            document.getElementById('category-badge').innerText = `${category.type === 'video' ? 'Vídeos (.avi)' : 'Imagens'} (5 Itens)`;
            document.getElementById('content-description').innerText = `Explore os 5 ficheiros disponíveis na pasta correspondente à categoria ${category.name}. Clique em qualquer um dos itens para abrir o visualizador interativo.`;

            // Render 5 sample buttons
            const itemsContainer = document.getElementById('items-container');
            itemsContainer.innerHTML = '';

            for (let i = 1; i <= 5; i++) {
                const numStr = i < 10 ? `0${i}` : `${i}`;
                const fileName = `${category.folder}${numStr}.${category.ext}`;
                
                const itemCard = document.createElement('div');
                itemCard.className = "bg-sage-50 border border-sage-200 hover:border-sage-300 rounded-xl p-4 flex flex-col justify-between gap-3 shadow-sm hover:shadow transition-all group";
                
                itemCard.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-sage-200 text-sage-800 flex items-center justify-center font-bold text-sm">
                            ${numStr}
                        </div>
                        <div class="overflow-hidden">
                            <h4 class="font-semibold text-sage-900 text-sm truncate">${fileName}</h4>
                            <span class="text-xs text-sage-500 uppercase">${category.type === 'video' ? 'Vídeo AVI' : 'Imagem'}</span>
                        </div>
                    </div>
                    <button class="w-full py-2 bg-sage-700 group-hover:bg-sage-800 text-white text-xs font-semibold rounded-lg transition-colors flex items-center justify-center gap-1.5 shadow-sm">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                        Abrir ${category.name.slice(0, -1) || category.name}
                    </button>
                `;

                itemCard.querySelector('button').onclick = () => openMediaModal(category, fileName, i);
                itemsContainer.appendChild(itemCard);
            }
        }

        function openMediaModal(category, fileName, index) {
            const modal = document.getElementById('media-modal');
            const modalTitle = document.getElementById('modal-title');
            const mediaContainer = document.getElementById('modal-media-container');
            const textBox = document.getElementById('modal-text-box');

            modalTitle.innerText = `Visualizando: ${fileName}`;
            
            // Generate media element
            if (category.type === 'video') {
                mediaContainer.innerHTML = `
                    <div class="flex flex-col items-center justify-center py-10 px-4 text-center bg-sage-900 text-white rounded-lg w-full">
                        <svg class="w-16 h-16 text-sage-300 mb-3 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <p class="font-semibold text-lg mb-1">${fileName}</p>
                        <p class="text-xs text-sage-300 mb-4">Reprodução de vídeo de demonstração tática de damas (.avi)</p>
                        <video controls class="w-full max-h-48 rounded bg-black">
                            <source src="" type="video/avi">
                            O seu navegador não suporta a tag de vídeo.
                        </video>
                    </div>
                `;
            } else {
                mediaContainer.innerHTML = `
                    <img src="Imagens para decorar/tabuleiros.gif" 
                         onerror="this.src='https://placehold.co/500x300/e3eae3/354635?text=${fileName}';" 
                         alt="${fileName}" 
                         class="max-h-[50vh] object-contain rounded-lg shadow">
                `;
            }

            textBox.innerHTML = `
                <p class="font-semibold text-sage-800 mb-1">Informações do Ficheiro:</p>
                <p class="text-sage-600">Este ficheiro pertence à secção <strong>${category.name}</strong> com o identificador <strong>${fileName}</strong>. Demonstra uma posição ou jogada avançada no jogo de damas.</p>
            `;

            modal.classList.remove('hidden');
        }

        function closeModal() {
            const modal = document.getElementById('media-modal');
            modal.classList.add('hidden');
        }

        // Close modal on escape key
        window.onkeydown = function(event) {
            if (event.key === "Escape") {
                closeModal();
            }
        };
    </script>
</body>
</html>